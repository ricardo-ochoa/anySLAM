# Copia a `.env.local` para desarrollo. En producción, estas mismas variables
# van en Vercel → Settings → Environment Variables.
#
# `.env.local` está en .gitignore. Ningún valor real debe entrar al repositorio.

# --- Dominio público --------------------------------------------------------
# Lo usan las etiquetas de Open Graph y los enlaces de /llms.txt, que tienen que
# ser absolutos. Se lee EN EL BUILD, no al arrancar.
NEXT_PUBLIC_SITE_URL=https://any-slam.vercel.app

# --- Clerk · quién entra ----------------------------------------------------
# Del panel de Clerk → API keys. La `pk_` es pública y viaja al navegador;
# la `sk_` es secreta y solo existe en el servidor.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# A dónde manda Clerk a quien no tiene sesión. Van SIN prefijo de idioma a
# propósito: el middleware de idioma redirige /sign-in al idioma del navegador,
# así que un visitante en inglés acaba en /en/sign-in sin configurar nada.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_WAITLIST_URL=/waitlist
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- El Company Brain lee la documentación ----------------------------------
# Token que deja pasar a /llms.txt, /llms-full.txt y al Markdown de cada página
# sin sesión de navegador. El Brain lo manda como `Authorization: Bearer …`.
# Genéralo con:  openssl rand -hex 32
DOCS_ACCESS_TOKEN=

# --- El portal pregunta al Company Brain ------------------------------------
# Mientras estén vacías, /chat avisa de que el Brain no está conectado y
# /api/chat responde 503. No rompen nada.
BRAIN_API_URL=
BRAIN_API_TOKEN=
